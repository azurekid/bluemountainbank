# Azure SQL Database Configuration for Blue Mountain Bank

# Database Connection Settings
AZURE_SQL_SERVER=bluemountainbank.database.windows.net
AZURE_SQL_DATABASE=BlueMountainBankDB
AZURE_SQL_USERNAME=bmb_admin
AZURE_SQL_PASSWORD=YourSecurePassword123!

# Connection Pool Settings
AZURE_SQL_POOL_MIN=0
AZURE_SQL_POOL_MAX=10
AZURE_SQL_POOL_IDLE_TIMEOUT=30000
AZURE_SQL_CONNECTION_TIMEOUT=15000
AZURE_SQL_REQUEST_TIMEOUT=15000

# Security Settings
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false

# Application Settings
NODE_ENV=development
PORT=3001

# JWT Settings (for authentication)
JWT_SECRET=BMB_2025_Super_Secure_JWT_Secret_Key_For_Production_Use_Random_String_a9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0
JWT_EXPIRES_IN=24h

# Azure Storage (existing)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_CONTAINER_NAME=job-applications

# Email Configuration (existing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
